# Пример конфигурации. Скопируйте в .env и раскомментируйте нужное.
# Полный список переменных с описаниями — в docs/справочник.md.
# Все значения ниже — дефолты, задавать их не обязательно.

# Инфраструктура
# DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://user:pass@db:5432/app

# Логика (переключается без правки кода)
# SOLVER_MODE=improved   # baseline_fifo | improved | benchmark_ortools | ortools_office
# DIST_MODE=haversine
# GEOCODER=nominatim     # nominatim | districts
# REGION=vostok
# SHIFT_START=08:00
# SHIFT_END=20:00

# Карта и дорожная геометрия
# OSRM_ENABLED=true      # false — прямые линии вместо маршрутов по дорогам
# OSRM_URL=https://router.project-osrm.org
# OSRM_TIMEOUT=4
# OSRM_TABLE_MAX_POINTS=100
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# Два режима на OR-Tools: pip install -r requirements-benchmark.txt
# ORTOOLS_TIME_LIMIT=5
# ORTOOLS_DROP_PENALTY=100000
# ORTOOLS_URGENT_PENALTY_FACTOR=3
# ORTOOLS_FIXED_VEHICLE_COST=45
# ORTOOLS_SLACK_MAX=1440
# ORTOOLS_FIRST_SOLUTION=parallel_cheapest_insertion
# ORTOOLS_LOCAL_SEARCH=guided_local_search

# Режим «Контур» (ortools_office)
# ORTOOLS_OFFICE_MATRIX=osrm        # osrm — дорожная матрица, haversine — по прямой
# ORTOOLS_OFFICE_WAIT_PENALTY=500
